# EventEase — Environment Configuration
# Copy this file to .env and fill in your Supabase credentials:

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (found in Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Note: EventEase includes an automatic Demo Database mode if Supabase keys are not provided.
# You can test all hackathon features instantly out of the box!
